# Local server configuration (PRD section 10). Copy to .env and edit as needed.
# Precedence, highest first: values saved in Settings, environment variables, these defaults.
# The server reads these from M2 onward.

# STUDIO_DATA_DIR=~/.studio
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=8080
# STUDIO_WORKER_URL=
# STUDIO_WORKER_TOKEN=
# STUDIO_POLL_INTERVAL_S=2
# STUDIO_UNREACHABLE_GRACE_S=600
# STUDIO_DOWNLOAD_INTERMEDIATES=true
# STUDIO_LOG_LEVEL=INFO
