# Normalize line endings: LF in the repo and in the working tree
* text=auto eol=lf

# Binary files: never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.flac binary
*.wav  binary
*.mp3  binary
*.npy  binary
*.db   binary
*.sqlite binary

# Windows-only scripts keep CRLF (only matters if you ever add any)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf