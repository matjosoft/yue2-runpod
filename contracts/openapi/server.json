    "/api/generations/{id}/artifacts/{name}": {
      "get": {
        "description": "A stored artifact, with HTTP Range support (S-7). Only names in the generation's\nmanifest that are stored locally are served.",
        "operationId": "get_artifact_api_generations__id__artifacts__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "title": "Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Range",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Range"
            }
