{
  "components": {
    "schemas": {
      "Artifact": {
        "description": "One entry of a job's artifact manifest. ``name`` is a relative POSIX path.",
        "properties": {
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ArtifactRole"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "role",
          "media_type",
          "size_bytes",
          "sha256"
        ],
        "title": "Artifact",
        "type": "object"
      },
      "ArtifactRole": {
        "enum": [
          "primary_audio",
          "score",
          "plan",
          "result",
          "intermediate",
          "other"
        ],
        "title": "ArtifactRole",
        "type": "string"
      },
      "Capabilities": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "engine": {
            "$ref": "#/components/schemas/EngineInfo"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/OperationInfo"
            },
            "title": "Operations",
            "type": "array"
          },
          "worker_version": {
            "title": "Worker Version",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "worker_version",
          "engine",
          "operations"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "EngineInfo": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "models": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Models",
            "type": "object"
          },
          "package_version": {
            "title": "Package Version",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "package_version",
          "models"
        ],
        "title": "EngineInfo",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Worker error codes. The server's own client-side codes are ``ClientErrorCode``.",
        "enum": [
          "unauthorized",
          "not_found",
          "conflict",
          "validation_error",
          "queue_full",
          "not_ready",
          "oom",
          "engine_error",
          "worker_restarted",
          "internal"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorEnvelope": {
        "description": "Every non-2xx response body: ``{\"error\": {...}}``.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorInfo": {
        "description": "The object inside every error envelope, and ``job.error`` for failed jobs.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorInfo",
        "type": "object"
      },
      "GpuInfo": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "vram_total_mb": {
            "title": "Vram Total Mb",
            "type": "integer"
          },
          "vram_used_mb": {
            "title": "Vram Used Mb",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "vram_total_mb",
          "vram_used_mb"
        ],
        "title": "GpuInfo",
        "type": "object"
      },
      "Health": {
        "description": "``GET /healthz``: ``{\"ok\": true}`` and nothing else.",
        "properties": {
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "Job": {
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/Artifact"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "client_request_id": {
            "title": "Client Request Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "operation": {
            "title": "Operation",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "params_resolved": {
            "additionalProperties": true,
            "title": "Params Resolved",
            "type": "object"
          },
          "progress": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "stages": {
            "items": {
              "type": "string"
            },
            "title": "Stages",
            "type": "array"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings",
            "type": "object"
          }
        },
        "required": [
          "id",
          "client_request_id",
          "operation",
          "state",
          "stage",
          "stages",
          "progress",
          "params",
          "params_resolved",
          "created_at",
          "started_at",
          "finished_at",
          "timings",
          "error",
          "artifacts"
        ],
        "title": "Job",
        "type": "object"
      },
      "JobList": {
        "description": "Body of ``GET /v1/jobs``: recent jobs, newest first, at most 50.",
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "JobList",
        "type": "object"
      },
      "JobState": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "canceled"
        ],
        "title": "JobState",
        "type": "string"
      },
      "JobSubmit": {
        "additionalProperties": false,
        "description": "Body of ``POST /v1/jobs``. ``params`` is validated against the operation's model.",
        "properties": {
          "client_request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Request Id",
            "type": "string"
          },
          "operation": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Operation",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "client_request_id",
          "operation",
          "params"
        ],
        "title": "JobSubmit",
        "type": "object"
      },
      "ModelState": {
        "enum": [
          "loading",
          "ready",
          "error"
        ],
        "title": "ModelState",
        "type": "string"
      },
      "ModelStatus": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "state": {
            "$ref": "#/components/schemas/ModelState"
          }
        },
        "required": [
          "state",
          "error"
        ],
        "title": "ModelStatus",
        "type": "object"
      },
      "OperationInfo": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "params_schema": {
            "additionalProperties": true,
            "title": "Params Schema",
            "type": "object"
          },
          "stages": {
            "items": {
              "type": "string"
            },
            "title": "Stages",
            "type": "array"
          }
        },
        "required": [
          "name",
          "stages",
          "params_schema"
        ],
        "title": "OperationInfo",
        "type": "object"
      },
      "QueueStatus": {
        "properties": {
          "max": {
            "title": "Max",
            "type": "integer"
          },
          "queued": {
            "title": "Queued",
            "type": "integer"
          },
          "running": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Running"
          }
        },
        "required": [
          "queued",
          "running",
          "max"
        ],
        "title": "QueueStatus",
        "type": "object"
      },
      "WorkerStatus": {
        "properties": {
          "gpu": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GpuInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "idle_seconds": {
            "title": "Idle Seconds",
            "type": "integer"
          },
          "model": {
            "$ref": "#/components/schemas/ModelStatus"
          },
          "queue": {
            "$ref": "#/components/schemas/QueueStatus"
          },
          "uptime_s": {
            "title": "Uptime S",
            "type": "integer"
          }
        },
        "required": [
          "uptime_s",
          "idle_seconds",
          "model",
          "gpu",
          "queue"
        ],
        "title": "WorkerStatus",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "WORKER_API_KEY",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Studio worker",
    "version": "0.1.0"
  },
